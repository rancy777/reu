{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Regression Case",
  "type": "object",
  "required": [
    "regression_id",
    "category",
    "input",
    "expected",
    "assertions"
  ],
  "properties": {
    "regression_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "routing",
        "classification",
        "evidence",
        "provider",
        "compatibility",
        "failure-diagnosis",
        "reporting",
        "safety"
      ]
    },
    "input": {
      "type": "object"
    },
    "expected": {
      "type": "object"
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "last_run": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}