{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runtime Compatibility Observation",
  "type": "object",
  "required": [
    "compat_id",
    "subject",
    "environment",
    "result",
    "evidence_ids"
  ],
  "properties": {
    "compat_id": {
      "type": "string"
    },
    "subject": {
      "type": "object",
      "required": [
        "capability"
      ],
      "properties": {
        "capability": {
          "type": "string"
        },
        "provider_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "properties": {
        "os": {
          "type": [
            "string",
            "null"
          ]
        },
        "arch": {
          "type": [
            "string",
            "null"
          ]
        },
        "android_api": {
          "type": [
            "integer",
            "null"
          ]
        },
        "abi": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime": {
          "type": [
            "string",
            "null"
          ]
        },
        "device_or_emulator": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "target": {
      "type": "object",
      "properties": {
        "platform": {
          "type": [
            "string",
            "null"
          ]
        },
        "architecture": {
          "type": [
            "string",
            "null"
          ]
        },
        "protector": {
          "type": [
            "string",
            "null"
          ]
        },
        "protector_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "result": {
      "type": "string",
      "enum": [
        "compatible",
        "partially-compatible",
        "incompatible",
        "unknown",
        "needs-verification"
      ]
    },
    "observed_failure": {
      "type": [
        "string",
        "null"
      ]
    },
    "test_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_at": {
      "type": "string"
    }
  }
}