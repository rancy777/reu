{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Graph Node",
  "type": "object",
  "required": [
    "node_id",
    "node_type",
    "label",
    "provenance"
  ],
  "properties": {
    "node_id": {
      "type": "string"
    },
    "node_type": {
      "type": "string",
      "enum": [
        "target",
        "artifact",
        "observation",
        "claim",
        "hypothesis",
        "experiment",
        "source",
        "case",
        "tool",
        "provider",
        "version",
        "runtime",
        "workflow",
        "failure",
        "technique",
        "protector"
      ]
    },
    "label": {
      "type": "string"
    },
    "value": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "type": [
        "object",
        "null"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "created_at"
      ],
      "properties": {
        "created_at": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "confidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}